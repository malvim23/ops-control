rules_version = '2';

// Regras para o projeto Firebase "presencasde" — app OPS Control
// A app usa um login simples por nome (localStorage), sem Firebase Auth,
// por isso o acesso às coleções fica aberto a quem tiver o link da app.
// Se mais tarde quiseres restringir, troca "if true" por "if request.auth != null"
// e ativa o Firebase Auth (Google Sign-In) no ficheiro index.html.

service cloud.firestore {
  match /databases/{database}/documents {

    match /stores/{storeId} {
      allow read, write: if true;
    }

    match /employees/{employeeId} {
      allow read, write: if true;
    }

    match /clients/{clientId} {
      allow read, write: if true;
    }

    match /schedule/{monthKey} {
      allow read, write: if true;
    }

    match /backups/{backupId} {
      allow read, write: if true;
    }

    match /auditLog/{logId} {
      allow read, write: if true;
    }

    // Bloqueia tudo o resto por omissão
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
